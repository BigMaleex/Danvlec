<?import javafx.scene.layout.VBox?>


<AnchorPane fx:id="APMain" prefHeight="400.0" prefWidth="600.0" styleClass="rootActive" stylesheets="@../CSS/PopupCustomClock.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.PopupCustomClockController">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="129.0" layoutY="52.0" prefHeight="200.0" prefWidth="100.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
