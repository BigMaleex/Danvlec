            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="0.0" spacing="10.0">
               <children>
                  <ToggleButton fx:id="BTNBlue" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="SPBlue" HBox.hgrow="ALWAYS">
                     <toggleGroup>
                        <ToggleGroup fx:id="Colors" />
                     </toggleGroup>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </ToggleButton>
                  <ToggleButton fx:id="BTNGreen" layoutX="10.0" layoutY="10.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="SPGreen" toggleGroup="$Colors" HBox.hgrow="ALWAYS">
                     <cursor>
