                  </ToggleButton>
                  <ToggleButton fx:id="BTNYellow" layoutX="552.0" layoutY="10.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="SPYellow" toggleGroup="$Colors" HBox.hgrow="ALWAYS">
                     <cursor>
